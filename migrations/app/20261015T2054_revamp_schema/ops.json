  {
    "id": "table.Zone",
    "label": "Create table \"Zone\"",
    "summary": "Creates table \"Zone\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Zone"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Zone\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Zone\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"Zone\"",
        "sql": "CREATE TABLE \"public\".\"Zone\" (\n  \"centerLat\" float8,\n  \"centerLng\" float8,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"enabled\" bool DEFAULT true NOT NULL,\n  \"id\" text NOT NULL,\n  \"kind\" text NOT NULL,\n  \"label\" text DEFAULT '' NOT NULL,\n  \"maxAltM\" float8,\n  \"minAltM\" float8,\n  \"missionId\" text NOT NULL,\n  \"radiusM\" float8,\n  \"shape\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"vertices\" jsonb,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Zone_kind_check_6eea59b1\" CHECK (\"kind\" IN ('no_fly', 'keep_in', 'keep_out')),\n  CONSTRAINT \"Zone_shape_check_0f40d968\" CHECK (\"shape\" IN ('circle', 'polygon'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Zone\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Zone\""
        ]
      }
    ]
  },
