# Required for Flight Deck (the ATLAS/SENTINEL agentic mission planner).
# Get a key at https://console.anthropic.com/ and copy this file to .env.local
ANTHROPIC_API_KEY=

# Required to sign in. Single shared password gate — no user database.
AUTH_PASSWORD=

# Required to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=
