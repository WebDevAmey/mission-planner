# Required for Flight Deck (the ATLAS/SENTINEL agentic mission planner).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required. PostgreSQL connection string used by both the app and the Prisma
# CLI (via `prisma.config.ts`, which loads this file through `dotenv/config`).
# Local dev: point this at a local Postgres database.
# Production: use your managed Postgres provider's pooled connection string.
# See README.md for setup instructions for both.
DATABASE_URL="postgresql://user:password@localhost:5432/mission_planner_dev?schema=public"

# Optional. Sends real verification/password-reset emails via the Resend API
# (https://resend.com — no SDK required, called with a plain fetch). Without
# this set, those emails are not sent; non-production environments instead
# get a working link back in the API response so the flow stays testable.
RESEND_API_KEY=
EMAIL_FROM="Flight Deck <onboarding@resend.dev>"
