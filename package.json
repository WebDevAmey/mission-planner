{
  "name": "mission-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs",
    "dev": "pnpm maplibre:worker && next dev",
    "build": "pnpm contract:emit && pnpm maplibre:worker && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "contract:emit": "prisma contract emit",
    "db:plan": "pnpm contract:emit && prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:sign": "prisma db sign",
    "db:seed": "tsx src/prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "design:lint": "bash scripts/design-lint.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@arclux/arc-ui": "4.9.1",
    "@arclux/arc-ui-react": "4.8.2",
    "@internationalized/date": "^3.12.4",
    "@langchain/anthropic": "1.5.1",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.2.2",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "lit": "^3.3.3",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "~6.11.2",
    "motion": "^13.1.1",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "uuid": "^13.0.2",
    "zod": "4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@prisma/cli-engine": "0.7.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "8.0.0-rc.22",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "nanoid@<4": "^3.3.18",
      "source-map-js": "^1.2.2",
      "protocol-buffers-schema": "^3.6.1",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "@babel/core": "^7.29.6",
      "sharp": "^0.35.5"
    }
  },
  "packageManager": "pnpm@10.30.0"
}
