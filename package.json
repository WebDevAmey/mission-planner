{
  "name": "mission-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm contract:emit && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "contract:emit": "prisma contract emit",
    "db:plan": "pnpm contract:emit && prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:sign": "prisma db sign",
    "db:seed": "tsx src/prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "design:lint": "bash scripts/design-lint.sh"
  },
  "dependencies": {
    "@arclux/arc-ui": "4.9.1",
    "@arclux/arc-ui-react": "4.8.2",
    "@internationalized/date": "^3.12.4",
    "@langchain/anthropic": "1.5.1",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.2.2",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "lit": "^3.3.3",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.21.1",
    "motion": "^13.1.1",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.7.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "8.0.0-rc.22",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
